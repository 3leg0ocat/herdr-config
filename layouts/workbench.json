{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "preview": "layouts/workbench.svg",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 268 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        { "id": "brand", "type": "block", "size": { "px": 46 }, "window_drag": true,
          "content": { "mod": "workspace-chrome" } },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            { "id": "spaces", "type": "block", "size": { "weight": 1 }, "min": 90, "content": { "mod": "spaces" } },
            { "id": "agents", "type": "block", "size": { "weight": 1 }, "min": 90, "content": { "mod": "agents" } },
            { "id": "notes", "type": "block", "size": { "weight": 1 }, "min": 140,
              "content": { "mod": "sakwa", "props": { "role": "sidebar", "bare": true } } }
          ]
        },
        { "id": "sidebar-footer", "type": "block", "size": { "px": 69 },
          "content": { "mod": "workspace-chrome", "props": { "footer": true } } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 42 },
          "window_drag": true,
          "content": {
            "mod": "better-tabs",
            "props": {
              "rememberPanels": { "container": "panel", "stack": "panel-body" },
              "buttons": [
                { "id": "files", "label": "Files", "icon": "file", "group": "panels",
                  "action": { "type": "panel", "container": "panel", "stack": "panel-body", "target": "files" } },
                { "id": "changes", "label": "Changes", "icon": "changes", "group": "panels",
                  "action": { "type": "panel", "container": "panel", "stack": "panel-body", "target": "changes" } },
                { "id": "github", "label": "GitHub", "icon": "mods/github/github.svg", "group": "panels",
                  "action": { "type": "panel", "container": "panel", "stack": "panel-body", "target": "github" } },
                { "id": "automations", "label": "Automations", "icon": "mods/automations/automations.svg", "group": "panels",
                  "action": { "type": "panel", "container": "panel", "stack": "panel-body", "target": "automations" } }
              ]
            }
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "header": { "content": { "mod": "better-changes" }, "height": 30, "position": "top", "reveal": "always" }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 368 },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "better-files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "better-changes" } },
                    { "id": "github", "type": "block", "content": { "mod": "github" } },
                    { "id": "automations", "type": "block", "content": { "mod": "automations" } }
                  ]
                }
              ]
            }
          ]
        },
        { "id": "status", "type": "block", "size": { "px": 28 }, "content": { "mod": "workspace-status" } }
      ]
    }
  ]
}
