+// No slash at the end but a drive's or /'s. Each system's own slashes are kept, as a
+// terminal's folder keeps them, so the header shows a typed folder the way it shows that.
+const tidyPath = (path) => (/^(?:[A-Za-z]:)?[\\/]$/.test(path) ? path : path.replace(/[\\/]+$/, ""));
+
+// A file's folder and name; a drive's top keeps its slash.
+function splitPath(path) {
+  const at = Math.max(path.lastIndexOf("/"), path.lastIndexOf("\\"));
+  let folder = path.slice(0, at);
+  if (/^[A-Za-z]:$/.test(folder)) folder += path[at];
+  return { folder: folder || "/", name: path.slice(at + 1) };
+}
+
+// The same folder, however its slashes and (on Windows) its letters are written.
+const sameFolder = (a, b) => {
+  const norm = (p) => {
+    const q = tidyPath(p).replace(/\\/g, "/");
+    return /^[A-Za-z]:/.test(q) ? q.toLowerCase() : q;
+  };
+  return norm(a) === norm(b);
+};
+
+// What went wrong with a typed path, worded as Explorer words it.
+export function pathProblem(path, code) {
+  if (code === RESOLVE_DENIED) return `Access to "${path}" is denied. You do not have permission to open this folder.`;
+  return `Cannot find "${path}". Check the spelling and try again.`;
+}
+
+// What a typed path is, as an absolute path on the machine the tree reads. The path is taken
+// as typed: only the spaces around it are left out.
+async function resolvePath(path, base, on) {
+  const platform = on ? null : window()?.platform;
+  const { program, args } = pickResolve(path, base, platform);
+  const r = await exec(program, args, { on });
+  if (r.code === RESOLVE_MISSING || r.code === RESOLVE_DENIED) throw new Error(pathProblem(path, r.code));
+  const [kind, found] = r.code === 0 ? r.stdout.split("\0") : [];
+  if (!found) throw new Error(`Cannot open "${path}". ${r.stderr?.trim() || "The path could not be read."}`);
+  return { dir: kind === "d", path: tidyPath(found) };
+}
