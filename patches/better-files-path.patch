+// --- A path typed in the header ---
+// Wire contract (both): `d` or `f`, NUL, the absolute path. A relative path is read from
+// $2, `~` is the home folder. Exit RESOLVE_MISSING when there is nothing there (or the path
+// can't be one), RESOLVE_DENIED for a folder that can't be read.
+export const RESOLVE_MISSING = 2;
+export const RESOLVE_DENIED = 3;
+
+const RESOLVE_SH = `p=$1; case $p in "~") p=$HOME ;; "~/"*) p=$HOME/\${p#"~/"} ;; /*) ;; *) [ -n "$2" ] || exit ${RESOLVE_MISSING}; p=$2/$p ;; esac
+if [ -d "$p" ]; then { [ -r "$p" ] && [ -x "$p" ]; } || exit ${RESOLVE_DENIED}; cd -- "$p" || exit ${RESOLVE_DENIED}; printf 'd\\0%s' "$(pwd)"
+elif [ -e "$p" ]; then d=$(cd -- "$(dirname -- "$p")" && pwd) || exit ${RESOLVE_DENIED}; printf 'f\\0%s/%s' "\${d%/}" "$(basename -- "$p")"
+else exit ${RESOLVE_MISSING}; fi`;
+
+// A bare drive (`D:`) means its top, as in Explorer, not that drive's current folder.
+const RESOLVE_PS = `[Console]::OutputEncoding=[Text.Encoding]::UTF8; try { $p=[Environment]::ExpandEnvironmentVariables($args[0]); $b=$args[1]; if ($p -eq '~' -or $p -like '~/*' -or $p -like '~\\*') { $p=$HOME + $p.Substring(1) }; if ($p -match '^[A-Za-z]:$') { $p+='\\' }; if (-not [IO.Path]::IsPathRooted($p)) { if (-not $b) { exit ${RESOLVE_MISSING} }; $p=Join-Path $b $p }; $i=Get-Item -LiteralPath $p -Force -ErrorAction Stop } catch [UnauthorizedAccessException] { exit ${RESOLVE_DENIED} } catch { exit ${RESOLVE_MISSING} }; if ($i.PSIsContainer) { try { Get-ChildItem -LiteralPath $i.FullName -Force -ErrorAction Stop | Select-Object -First 1 | Out-Null } catch { exit ${RESOLVE_DENIED} } }; $k=if ($i.PSIsContainer) {'d'} else {'f'}; [Console]::Out.Write($k + [char]0 + $i.FullName)`;
+
+export function pickResolve(path, base, platform) {
+  if (isWin(platform)) {
+    return {
+      program: "powershell.exe",
+      args: ["-NoProfile", "-NoLogo", "-Command", `& { ${RESOLVE_PS} } ${psQuote(path)} ${psQuote(base ?? "")}`],
+    };
+  }
+  return { program: "sh", args: ["-c", RESOLVE_SH, "resolve", path, base ?? ""] };
+}
+
