--- /dev/null
+++ b/mods/better-files/views/path.js
@@ -0,0 +1,111 @@
+// The header's folder as a path you can type over, the way Explorer's address bar works:
+// click the title, type or paste a folder or a file, Enter goes there, Escape or a click
+// elsewhere leaves it as it was.
+import { div } from "gpui-kit";
+import { h_flex } from "gpui-base";
+import { baseName } from "../files/model.js";
+import { Badge, IconButton, TextField } from "./ui.js";
+
+const FOLDER_LABEL = 28;
+// The input is drawn on the next frame, so the keyboard goes to it a moment later.
+const FOCUS_MS = 30;
+
+// The folder on show, short enough to leave the buttons room. As upstream draws it.
+const folderLabel = (root) => {
+  const name = root ? baseName(root) : "";
+  if (!name) return null;
+  return name.length > FOLDER_LABEL ? `${name.slice(0, FOLDER_LABEL)}…` : name;
+};
+
+export const pathMethods = {
+  startPathEdit(cx) {
+    if (!this.root) return;
+    this.editingPath = true;
+    this.pathError = null;
+    this.pathInput.set_value(this.root);
+    cx.notify();
+    cx.timer.after(FOCUS_MS, () => {
+      if (!this.editingPath) return;
+      this.pathInput.focus();
+      this.pathInput.set_selected_range({ start: 0, end: this.pathInput.value().length });
+    });
+  },
+
+  endPathEdit(cx) {
+    if (!this.editingPath) return;
+    this.editingPath = false;
+    this.pathError = null;
+    cx.notify();
+  },
+
+  submitPath(cx) {
+    const text = this.pathInput.value();
+    if (!text.trim() || text === this.root) return this.endPathEdit(cx);
+    this.pathBusy = true;
+    cx.notify();
+    cx.spawn(async (cx) => {
+      try {
+        await this.goTo(text, cx);
+        this.editingPath = false;
+        this.pathError = null;
+        this.treeFocus.focus();
+      } catch (e) {
+        // Left open, to put right.
+        this.pathError = e.message ?? String(e);
+      } finally {
+        this.pathBusy = false;
+        cx.notify();
+      }
+    });
+  },
+
+  // The title, or the box in its place: only the title's room, so the buttons beside it stay
+  // where they were, clear of its border.
+  pathTitle(t) {
+    if (this.editingPath)
+      return h_flex()
+        .id("files-path")
+        .flex_1()
+        .min_w(0)
+        .mr(2)
+        .items_center()
+        .on_key_down((event, cx) => {
+          if (event.keystroke !== "escape") return;
+          cx.stop_propagation();
+          this.endPathEdit(cx);
+        })
+        .child(TextField({ id: "files-path-input", state: this.pathInput, height: 26 }));
+    const label = folderLabel(this.root);
+    const away = this.browsing();
+    return h_flex()
+      .id("files-title")
+      .flex_1()
+      .min_w(0)
+      .gap(6)
+      .items_center()
+      .when(Boolean(this.root), (el) =>
+        el
+          .cursor_text()
+          .tooltip(`${this.root}\nClick to type a path`)
+          .on_click((_e, cx) => this.startPathEdit(cx)),
+      )
+      .child(div().flex_none().font_medium().child("Files"))
+      .when(Boolean(label), (el) => {
+        // A long path, as Windows folders give, is cut short to fit beside the buttons.
+        const badge = Badge(label).flex_shrink(1).min_w(0).truncate();
+        return el.child(away ? badge.text_color(t.accent).border_color(t.accent) : badge);
+      });
+  },
+
+  // Refresh, as ever; on a typed folder it also goes back to the pane's own, read afresh.
+  refreshButton() {
+    const away = this.browsing();
+    return IconButton({
+      id: "files-refresh",
+      icon: "refresh",
+      label: away ? "Refresh and return to the terminal's folder" : "Refresh",
+      spinning: Boolean(this.loading || this.pathBusy),
+      onClick: (cx) => (away ? this.goBack(cx) : this.refresh(cx)),
+    });
+  },
+};
